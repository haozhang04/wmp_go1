<mujoco model="empty_world">
  <include file="go1.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <texture type="2d" name="wood_tex" builtin="flat" rgb1="0.55 0.35 0.2" width="512" height="512"/>
    <material name="wood_mat" texture="wood_tex" specular="0.2" shininess="0.1" rgba="1 1 1 1"/>
    <material name="runway_mat" rgba="0.18 0.55 0.38 1" specular="0.15" shininess="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- 无限底面在 z=-0.30；上方 30 cm 高跑道在 x=[7.8, 8.2] 留出 0.4 m gap。 -->
    <geom name="floor" type="plane" pos="0 0 -0.30" size="0 0 0.05" material="groundplane"/>
    <geom name="ground_before_gap" type="box" pos="1.3 0 -0.15" size="6.4 2.0 0.15" material="runway_mat"/>
    <geom name="ground_after_gap" type="box" pos="13.9 0 -0.15" size="5.675 2.0 0.15" material="runway_mat"/>

    <!-- 1. 匍匐障碍：x=[2.0, 3.0]，顶障下表面离地 0.30 m。 -->
    <geom name="crawl_overhead" type="box" pos="2.5 0 0.8" size="0.3 2.0 0.50" material="wood_mat"/>

    <!-- 2. 高台：x=[4.9, 6.1]，台面高度 0.40 m。 -->
    <geom name="platform_40cm" type="box" pos="5.5 0 0.20" size="0.6 2.0 0.20" rgba="0.20 0.62 0.95 1"/>

    <!-- 3. 0.4 m gap 位于 x=[7.8, 8.2]。 -->

    <!-- 4. 上下楼梯：单级长度 0.30 m、高度 0.20 m，最高 0.80 m。 -->
    <geom name="stair_up_1" type="box" pos="10.350 0 0.10" size="0.150 2.0 0.10" material="wood_mat"/>
    <geom name="stair_up_2" type="box" pos="10.650 0 0.20" size="0.150 2.0 0.20" material="wood_mat"/>
    <geom name="stair_up_3" type="box" pos="10.950 0 0.30" size="0.150 2.0 0.30" material="wood_mat"/>
    <geom name="stair_up_4" type="box" pos="11.250 0 0.40" size="0.150 2.0 0.40" material="wood_mat"/>
    <geom name="stair_top" type="box" pos="11.700 0 0.40" size="0.300 2.0 0.40" material="wood_mat"/>
    <geom name="stair_down_3" type="box" pos="12.150 0 0.30" size="0.150 2.0 0.30" material="wood_mat"/>
    <geom name="stair_down_2" type="box" pos="12.450 0 0.20" size="0.150 2.0 0.20" material="wood_mat"/>
    <geom name="stair_down_1" type="box" pos="12.750 0 0.10" size="0.150 2.0 0.10" material="wood_mat"/>

    <!-- 5. 30° 上下斜坡，中间平台高度约 1.00 m。 -->
    <geom name="slope_up" type="box" pos="15.800 0 0.457" size="1.0 2.0 0.05" euler="0 -0.523599 0" rgba="0.95 0.58 0.18 1"/>
    <geom name="slope_top" type="box" pos="17.241 0 0.500" size="0.60 2.0 0.500" rgba="0.95 0.58 0.18 1"/>
    <geom name="slope_down" type="box" pos="18.682 0 0.457" size="1.0 2.0 0.05" euler="0 0.523599 0" rgba="0.95 0.58 0.18 1"/>

    <!-- 6. 连续 gap：初始平台长 2.0 m，7 个踏板长 0.4 m，末端平台长 1.0 m。 -->
    <!-- 8 个 gap 依次为 0.18、0.20、0.23、0.25、0.28、0.30、0.32、0.35 m。 -->
    <geom name="continuous_gap_start" type="box" pos="20.550 0 -0.175" size="1.000 2.0 0.125" material="runway_mat"/>
    <geom name="continuous_gap_platform_1" type="box" pos="21.930 0 -0.190" size="0.200 2.0 0.110" material="wood_mat"/>
    <geom name="continuous_gap_platform_2" type="box" pos="22.530 0 -0.165" size="0.200 2.0 0.135" material="wood_mat"/>
    <geom name="continuous_gap_platform_3" type="box" pos="23.160 0 -0.180" size="0.200 2.0 0.120" material="wood_mat"/>
    <geom name="continuous_gap_platform_4" type="box" pos="23.810 0 -0.155" size="0.200 2.0 0.145" material="wood_mat"/>
    <geom name="continuous_gap_platform_5" type="box" pos="24.490 0 -0.185" size="0.200 2.0 0.115" material="wood_mat"/>
    <geom name="continuous_gap_platform_6" type="box" pos="25.190 0 -0.170" size="0.200 2.0 0.130" material="wood_mat"/>
    <geom name="continuous_gap_platform_7" type="box" pos="25.910 0 -0.175" size="0.200 2.0 0.125" material="wood_mat"/>
    <geom name="continuous_gap_end" type="box" pos="26.960 0 -0.150" size="0.500 2.0 0.150" material="runway_mat"/>

    <!-- 7. 独木桥：x=[27.46, 30.46]，长 3.0 m、宽 0.28 m，桥面高度 0.30 m。 -->
    <geom name="balance_beam" type="box" pos="28.960 0 -0.150" size="1.500 0.130 0.150" material="wood_mat"/>
    <!-- 独木桥后平台：x=[30.46, 32.46]，长 2.0 m。 -->
    <geom name="balance_beam_end" type="box" pos="31.460 0 -0.150" size="1.000 2.000 0.150" material="runway_mat"/>

  </worldbody>
</mujoco>
